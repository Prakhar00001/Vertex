<div class="max-w-md mx-auto py-12">
  <h1 class="text-xl font-bold mb-4">Create Workspace</h1>
  <%= form_with model: @organization, class: "space-y-4" do |f| %>
    <div>
      <%= f.label :name, class: "block text-sm font-medium" %>
      <%= f.text_field :name, class: "w-full border rounded p-2 text-sm", required: true %>
    </div>
    <div>
      <%= f.label :slug, class: "block text-sm font-medium" %>
      <%= f.text_field :slug, class: "w-full border rounded p-2 text-sm", placeholder: "acme-corp" %>
    </div>
    <%= f.submit "Create", class: "w-full py-2 bg-indigo-600 text-white rounded font-medium" %>
  <% end %>
</div>