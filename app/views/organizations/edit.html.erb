<div class="max-w-md mx-auto py-12">
  <h1 class="text-xl font-bold mb-4">Edit Workspace Settings</h1>
  <%= form_with model: @organization, url: organization_path(@organization.slug), method: :patch, class: "space-y-4" do |f| %>
    <div>
      <%= f.label :name, class: "block text-sm font-medium" %>
      <%= f.text_field :name, class: "w-full border rounded p-2 text-sm" %>
    </div>
    <%= f.submit "Update", class: "w-full py-2 bg-indigo-600 text-white rounded font-medium" %>
  <% end %>
</div>