<aside class="w-64 bg-gray-900 text-gray-200 flex flex-col flex-shrink-0">
  <div class="p-4 border-b border-gray-800 flex items-center justify-between">
    <span class="font-bold text-white tracking-wide truncate"><%= Current.organization.name %></span>
  </div>
  <nav class="flex-1 p-4 space-y-1">
    <%= link_to "Dashboard", tenant_dashboard_path(org_slug: Current.organization.slug), class: "block px-3 py-2 rounded-md hover:bg-gray-800" %>
    <div class="pt-4 pb-1 text-xs font-semibold text-gray-400 uppercase tracking-wider">Projects</div>
    <% Current.organization.projects.each do |proj| %>
      <%= link_to proj.name, tenant_project_path(org_slug: Current.organization.slug, id: proj.id), class: "block px-3 py-2 rounded-md hover:bg-gray-800 text-sm" %>
    <% end %>
    <%= link_to "+ New Project", new_tenant_project_path(org_slug: Current.organization.slug), class: "block px-3 py-2 text-indigo-400 hover:text-indigo-300 text-xs" %>
  </nav>
  <div class="p-4 border-t border-gray-800 text-xs">
    <%= link_to "Team Members", tenant_memberships_path(org_slug: Current.organization.slug), class: "block py-1 hover:text-white" %>
    <%= button_to "Sign Out", destroy_user_session_path, method: :delete, class: "text-red-400 hover:text-red-300 bg-transparent border-0 cursor-pointer p-0 pt-2" %>
  </div>
</aside>