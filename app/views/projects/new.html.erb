<div class="max-w-md mx-auto py-12">
  <h1 class="text-xl font-bold mb-4">New Project</h1>
  <%= form_with model: @project, url: tenant_projects_path(org_slug: Current.organization.slug), class: "space-y-4" do |f| %>
    <div>
      <%= f.label :name, class: "block text-sm font-medium" %>
      <%= f.text_field :name, class: "w-full border rounded p-2 text-sm", required: true %>
    </div>
    <div>
      <%= f.label :key, class: "block text-sm font-medium" %>
      <%= f.text_field :key, class: "w-full border rounded p-2 text-sm uppercase", placeholder: "CORE", required: true %>
    </div>
    <div>
      <%= f.label :description, class: "block text-sm font-medium" %>
      <%= f.text_area :description, class: "w-full border rounded p-2 text-sm" %>
    </div>
    <%= f.submit "Create Project", class: "w-full py-2 bg-indigo-600 text-white rounded font-medium" %>
  <% end %>
</div>